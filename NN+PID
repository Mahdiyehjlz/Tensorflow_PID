# 5.  CLOSED-LOOP SIMULATION (with safety monitoring)
# ═══════════════════════════════════════════════════════════════════════════════

def run_closed_loop(model: keras.Model,
                    sx: StandardScaler,
                    sy: StandardScaler,
                    ref1: tuple = (0.5, 0.3, 5.0, 3.0),   # Conservative targets
                    ref2: tuple = (-0.3, 0.6, -4.0, 4.0),
                    T: float = 6.0,
                    dt: float = DT,
                    save_dir: str = "saved_model_2link") -> dict:
    """Run closed-loop simulation with safety monitoring."""
    n_steps = int(T / dt)
    robot = TwoLinkRobotSimulator(dt=dt)
    pid = TwoLinkRobotPIDController(dt=dt)
    
    @tf.function(input_signature=[tf.TensorSpec([1, N_IN], tf.float32)])
    def nn_infer(x_s):
        return model(x_s, training=False)
    
    log = {k: np.zeros(n_steps) for k in
           ["t", "q1", "q2", "dq1", "dq2", "tau1", "tau2",
            "tau1_hat", "tau2_hat", "tau1_cmd", "tau2_cmd",
            "x", "y"]}
    
    tau_cmd = np.zeros(2)
    stability_violations = 0
    
    print(f"\n[Closed-loop] Running {n_steps} steps (T={T}s, dt={dt}s) …")
    
    for k in range(n_steps):
        t = k * dt
        ref = ref1 if t < T / 2 else ref2
        
        # Get robot state
        q1, q2, dq1, dq2 = robot.q1, robot.q2, robot.dq1, robot.dq2
        
        # NN prediction
        nn_in = np.array([[tau_cmd[0], tau_cmd[1], q1, q2, dq1, dq2]], dtype=np.float32)
        nn_in_s = sx.transform(nn_in)
        nn_out = sy.inverse_transform(
            nn_infer(tf.constant(nn_in_s)).numpy()
        )[0]
        
        # Compute control
        tau_cmd = pid.compute(ref, q1, q2, nn_out[0], nn_out[1])
        
        # Step robot
        _, (tau1_act, tau2_act, ddq1, ddq2) = robot.step(tau_cmd)
        
        # Safety check
        if abs(ddq1) > DDQ_MAX * 0.9 or abs(ddq2) > DDQ_MAX * 0.9:
            stability_violations += 1
            if stability_violations > 10:
                print(f"  Warning: High accelerations detected at t={t:.2f}s")
        
        # Log data
        log["t"][k] = t
        log["q1"][k] = q1; log["q2"][k] = q2
        log["dq1"][k] = dq1; log["dq2"][k] = dq2
        log["tau1_hat"][k] = nn_out[0]; log["tau2_hat"][k] = nn_out[1]
        log["tau1"][k] = tau1_act; log["tau2"][k] = tau2_act
        log["tau1_cmd"][k] = tau_cmd[0]; log["tau2_cmd"][k] = tau_cmd[1]
        
        x, y = robot.get_end_effector_position()
        log["x"][k] = x; log["y"][k] = y
    
    print(f"  Simulation complete. Stability violations: {stability_violations}")
    plot_closed_loop(log, ref1, ref2, T, save_dir)
    return log



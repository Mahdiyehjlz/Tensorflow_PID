# 6.  PLOTTING FUNCTIONS
# ═══════════════════════════════════════════════════════════════════════════════

def plot_training(history, save_dir: str):
    fig, axes = plt.subplots(1, 2, figsize=(12, 4))
    fig.suptitle("Forward Dynamics NN — Training Curves (2-Link Robot - STABLE)", fontsize=12)
    
    metrics = ["loss", "val_loss"]
    axes[0].plot(history.history[metrics[0]], label="Train")
    axes[0].plot(history.history[metrics[1]], label="Validation")
    axes[0].set_xlabel("Epoch"); axes[0].set_ylabel("MSE Loss")
    axes[0].set_title("Loss"); axes[0].legend(); axes[0].grid(True)
    axes[0].set_yscale('log')
    
    metrics = ["mae", "val_mae"]
    axes[1].plot(history.history[metrics[0]], label="Train")
    axes[1].plot(history.history[metrics[1]], label="Validation")
    axes[1].set_xlabel("Epoch"); axes[1].set_ylabel("MAE")
    axes[1].set_title("Mean Absolute Error"); axes[1].legend(); axes[1].grid(True)
    
    plt.tight_layout()
    out = os.path.join(save_dir, "training_curves.png")
    plt.savefig(out, dpi=150)
    plt.show()
    print(f"  Saved → {out}")


def plot_closed_loop(log: dict, ref1: tuple, ref2: tuple, T: float, save_dir: str):
    t = log["t"]
    t_mid = T / 2.0
    
    fig, axes = plt.subplots(3, 2, figsize=(14, 13))
    fig.suptitle(
        "Closed-Loop: 2-Link Robot (STABLE VERSION)\n"
        f"Phase-1 ref = {ref1}   Phase-2 ref = {ref2}", fontsize=11)
    
    def _ref_lines(ax, val1, val2, color):
        ax.axvline(t_mid, color="gray", ls="--", lw=0.8, alpha=0.6)
        ax.axhline(val1, color=color, ls=":", lw=1.5, alpha=0.7, label="ref phase 1")
        ax.axhline(val2, color=color, ls="-.", lw=1.5, alpha=0.7, label="ref phase 2")
    
    # Joint angles
    ax = axes[0, 0]
    _ref_lines(ax, ref1[0], ref2[0], "tab:blue")
    ax.plot(t, log["q1"], color="tab:blue", lw=1.8, label="q1 actual")
    ax.set_ylabel("q1 (rad)"); ax.set_title("Joint 1 Position")
    ax.legend(fontsize=8); ax.grid(True)
    
    ax = axes[0, 1]
    _ref_lines(ax, ref1[1], ref2[1], "tab:orange")
    ax.plot(t, log["q2"], color="tab:orange", lw=1.8, label="q2 actual")
    ax.set_ylabel("q2 (rad)"); ax.set_title("Joint 2 Position")
    ax.legend(fontsize=8); ax.grid(True)
    
    # Velocities
    ax = axes[1, 0]
    ax.plot(t, log["dq1"], color="tab:green", lw=1.5, label="dq1")
    ax.plot(t, log["dq2"], color="tab:red", lw=1.5, label="dq2")
    ax.set_ylabel("Velocity (rad/s)"); ax.set_title("Joint Velocities")
    ax.legend(fontsize=8); ax.grid(True)
    
    # Torques
    ax = axes[1, 1]
    ax.plot(t, log["tau1"], color="tab:green", lw=1.5, label="tau1 actual")
    ax.plot(t, log["tau1_hat"], color="lightgreen", lw=1.0, ls="--", label="tau1̂ NN")
    ax.plot(t, log["tau2"], color="tab:red", lw=1.5, label="tau2 actual")
    ax.plot(t, log["tau2_hat"], color="salmon", lw=1.0, ls="--", label="tau2̂ NN")
    ax.set_ylabel("Torque (Nm)"); ax.set_title("Joint Torques")
    ax.legend(fontsize=8); ax.grid(True)
    
    # Command torques
    ax = axes[2, 0]
    ax.plot(t, log["tau1_cmd"], color="tab:blue", lw=1.2, label="tau1 cmd")
    ax.plot(t, log["tau2_cmd"], color="tab:orange", lw=1.2, label="tau2 cmd")
    ax.axhline(TAU_MAX, color="k", ls="--", lw=0.8, alpha=0.5)
    ax.axhline(-TAU_MAX, color="k", ls="--", lw=0.8, alpha=0.5)
    ax.set_xlabel("Time (s)"); ax.set_ylabel("Torque (Nm)")
    ax.set_title("Command Torques"); ax.legend(fontsize=8); ax.grid(True)
    
    # End-effector trajectory
    ax = axes[2, 1]
    ax.plot(log["x"], log["y"], lw=1.8, color="steelblue", label="Path")
    ax.plot(log["x"][0], log["y"][0], "go", ms=9, label="Start")
    ax.plot(log["x"][-1], log["y"][-1], "rs", ms=9, label="End")
    mid = len(t) // 2
    ax.plot(log["x"][mid], log["y"][mid], "k^", ms=8, label="Switch")
    ax.set_xlabel("x (m)"); ax.set_ylabel("y (m)")
    ax.set_title("End-Effector Trajectory")
    ax.legend(fontsize=8); ax.grid(True); ax.set_aspect("equal")
    
    plt.tight_layout()
    out = os.path.join(save_dir, "closed_loop_stable_results.png")
    plt.savefig(out, dpi=150)
    plt.show()
    print(f"  Saved → {out}")



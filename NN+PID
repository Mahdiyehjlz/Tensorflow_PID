# 2.  TRAINING DATA GENERATION (with smoother exploration)
# ═══════════════════════════════════════════════════════════════════════════════

def generate_training_data(n_samples: int = 20_000, noise_std: float = 0.01):
    """
    Collect data using smooth random exploration for better coverage.
    """
    robot = TwoLinkRobotSimulator()
    X, Y = [], []
    tau = np.zeros(2)
    WARMUP = 200
    
    # Use smoother exploration
    for i in range(n_samples + WARMUP):
        # Periodic reset to explore different regions
        if i % 500 == 0:
            robot.reset()
            tau = np.random.uniform(-TAU_MAX * 0.5, TAU_MAX * 0.5, 2)
        else:
            # Smooth random walk with smaller steps
            tau += np.random.randn(2) * 3.0
            tau = np.clip(tau, -TAU_MAX * 0.8, TAU_MAX * 0.8)
        
        obs, (tau1_act, tau2_act, ddq1, ddq2) = robot.step(tau)
        q1, q2, dq1, dq2, tau1_cmd, tau2_cmd = obs
        
        # Only collect data in stable regions
        if i >= WARMUP and abs(ddq1) < DDQ_MAX * 0.8 and abs(ddq2) < DDQ_MAX * 0.8:
            row_x = [tau1_cmd, tau2_cmd, q1, q2, dq1, dq2]
            row_y = [tau1_act, tau2_act, ddq1, ddq2]
            if np.all(np.isfinite(row_x)) and np.all(np.isfinite(row_y)):
                X.append(row_x)
                Y.append(row_y)
            else:
                robot.reset()
                tau = np.zeros(2)
    
    X = np.array(X, dtype=np.float32)
    Y = np.array(Y, dtype=np.float32)
    
    print(f"Generated {len(X)} stable samples")
    
    # Add small noise for robustness
    if noise_std > 0:
        X[:, 2:6] += np.random.normal(0, noise_std, (len(X), 4))
        Y += np.random.normal(0, noise_std * 0.1, Y.shape)
    
    return X, Y


# ═══════════════════════════════════════════════════════════════════════════════
# 3.  FORWARD DYNAMICS NN (with regularization for stability)
# ═══════════════════════════════════════════════════════════════════════════════

def build_forward_dynamics_nn(lr: float = 5e-4) -> keras.Model:
    inp = keras.Input(shape=(N_IN,), name="robot_inputs")
    
    # Hidden layers with careful regularization
    x = layers.Dense(128, kernel_regularizer=keras.regularizers.l2(1e-5))(inp)
    x = layers.BatchNormalization()(x)
    x = layers.Activation("relu")(x)
    x = layers.Dropout(0.1)(x)
    
    x = layers.Dense(64, kernel_regularizer=keras.regularizers.l2(1e-5))(x)
    x = layers.BatchNormalization()(x)
    x = layers.Activation("relu")(x)
    x = layers.Dropout(0.1)(x)
    
    x = layers.Dense(32, kernel_regularizer=keras.regularizers.l2(1e-5))(x)
    x = layers.BatchNormalization()(x)
    x = layers.Activation("relu")(x)
    
    # Output layer
    out = layers.Dense(N_OUT, activation="linear")(x)
    
    model = keras.Model(inputs=inp, outputs=out, name="ForwardDynamicsNN")
    model.compile(
        optimizer=keras.optimizers.Adam(lr),
        loss="mse",
        metrics=["mae", tf.keras.metrics.RootMeanSquaredError(name="rmse")],
    )
    return model


def train_nn(X, Y, epochs: int = 150, batch_size: int = 64,
             save_dir: str = "saved_model_2link"):
    print("=" * 60)
    print("  Forward Dynamics NN — Training (2-Link Robot - STABLE)")
    print("=" * 60)
    
    X_tr, X_tmp, Y_tr, Y_tmp = train_test_split(
        X, Y, test_size=0.30, random_state=SEED)
    X_val, X_te, Y_val, Y_te = train_test_split(
        X_tmp, Y_tmp, test_size=0.50, random_state=SEED)
    
    # Scale features
    sx = StandardScaler().fit(X_tr)
    sy = StandardScaler().fit(Y_tr)
    
    Xtr_s = sx.transform(X_tr)
    Ytr_s = sy.transform(Y_tr)
    Xval_s = sx.transform(X_val)
    Yval_s = sy.transform(Y_val)
    
    print(f"  Train {len(X_tr)} | Val {len(X_val)} | Test {len(X_te)}")
    
    model = build_forward_dynamics_nn()
    model.summary()
    
    os.makedirs(save_dir, exist_ok=True)
    cb = [
        keras.callbacks.EarlyStopping(
            monitor="val_loss", patience=20,
            restore_best_weights=True, verbose=1),
        keras.callbacks.ReduceLROnPlateau(
            monitor="val_loss", factor=0.5, patience=10,
            min_lr=1e-6, verbose=1),
        keras.callbacks.ModelCheckpoint(
            os.path.join(save_dir, "best_model.keras"),
            monitor="val_loss", save_best_only=True),
    ]
    
    history = model.fit(
        Xtr_s, Ytr_s,
        validation_data=(Xval_s, Yval_s),
        epochs=epochs, batch_size=batch_size,
        callbacks=cb, verbose=1,
    )
    
    # Test evaluation
    Xte_s = sx.transform(X_te)
    Y_pred = sy.inverse_transform(model.predict(Xte_s, verbose=0))
    print(f"\n  {'Output':<12}  {'MAE':>10}  {'RMSE':>10}")
    print(f"  {'-'*36}")
    for i, name in enumerate(OUTPUT_NAMES):
        mae = np.mean(np.abs(Y_te[:, i] - Y_pred[:, i]))
        rmse = np.sqrt(np.mean((Y_te[:, i] - Y_pred[:, i]) ** 2))
        print(f"  {name:<12}  {mae:>10.4f}  {rmse:>10.4f}")
    
    plot_training(history, save_dir)
    return model, history, sx, sy



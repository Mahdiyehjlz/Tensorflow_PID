# 4.  PID CONTROLLER (with conservative gains)
# ═══════════════════════════════════════════════════════════════════════════════

class PID:
    """PID controller with anti-windup and output smoothing."""
    
    def __init__(self, kp: float, ki: float, kd: float,
                 dt: float = DT, limit: float = None, alpha: float = 0.9):
        self.kp, self.ki, self.kd = kp, ki, kd
        self.dt = dt
        self.limit = limit
        self.alpha = alpha  # Derivative filter coefficient
        self._i = 0.0
        self._e = 0.0
        self._d_filtered = 0.0
    
    def reset(self):
        self._i = 0.0
        self._e = 0.0
        self._d_filtered = 0.0
    
    def step(self, error: float) -> float:
        # Proportional term
        p = self.kp * error
        
        # Integral term with anti-windup
        self._i += error * self.dt
        i = self.ki * self._i
        
        # Derivative term with low-pass filter
        d_raw = (error - self._e) / self.dt if self.dt > 0 else 0
        self._d_filtered = self.alpha * self._d_filtered + (1 - self.alpha) * d_raw
        d = self.kd * self._d_filtered
        self._e = error
        
        out = p + i + d
        
        # Apply limit with anti-windup
        if self.limit is not None:
            if out > self.limit:
                out = self.limit
                if self.ki != 0:
                    self._i -= error * self.dt  # Anti-windup
            elif out < -self.limit:
                out = -self.limit
                if self.ki != 0:
                    self._i -= error * self.dt  # Anti-windup
        
        return out


class TwoLinkRobotPIDController:
    """
    Conservative PID controller for stable 2-link robot control.
    """
    
    def __init__(self, dt: float = DT):
        # Conservative gains for stability
        TAU_LIM = 20.0  # Reduced torque limit
        
        # Position loop (lower gains for stability)
        self.pid_q1 = PID(kp=20.0, ki=2.0, kd=3.0, dt=dt, limit=TAU_LIM, alpha=0.8)
        self.pid_q2 = PID(kp=15.0, ki=1.5, kd=2.5, dt=dt, limit=TAU_LIM, alpha=0.8)
        
        # Torque loop (very low gains - mainly for compensation)
        self.pid_tau1 = PID(kp=0.2, ki=0.05, kd=0.02, dt=dt, limit=TAU_LIM, alpha=0.95)
        self.pid_tau2 = PID(kp=0.2, ki=0.05, kd=0.02, dt=dt, limit=TAU_LIM, alpha=0.95)
    
    def reset(self):
        for pid in (self.pid_q1, self.pid_q2, self.pid_tau1, self.pid_tau2):
            pid.reset()
    
    def compute(self,
                ref: tuple,  # (q1*, q2*, tau1*, tau2*)
                q1: float, q2: float,
                tau1_hat: float, tau2_hat: float) -> np.ndarray:
        """Compute torque commands with stability limits."""
        q1_d, q2_d, tau1_d, tau2_d = ref
        
        # Error for position control
        q1_error = q1_d - q1
        q2_error = q2_d - q2
        
        # Error for torque control
        tau1_error = tau1_d - tau1_hat
        tau2_error = tau2_d - tau2_hat
        
        # Compute torque commands
        dtau1 = self.pid_q1.step(q1_error) + self.pid_tau1.step(tau1_error)
        dtau2 = self.pid_q2.step(q2_error) + self.pid_tau2.step(tau2_error)
        
        # Apply safe torque limits
        tau = np.clip(np.array([dtau1, dtau2]), -TAU_MAX, TAU_MAX)
        return tau



"""
2-Link Planar Robot — Forward Dynamics NN + PID Controller (STABLE VERSION)
===========================================================================

Corrected dynamics with proper stability measures.
"""

import os
import numpy as np
import tensorflow as tf
from tensorflow import keras
from tensorflow.keras import layers
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler

# ── Reproducibility ───────────────────────────────────────────────────────────
SEED = 42
np.random.seed(SEED)
tf.random.set_seed(SEED)

# ── Robot physical parameters (2-link planar manipulator) ─────────────────────
L1 = 1.0          # length of link 1 (m)
L2 = 0.8          # length of link 2 (m)
M1 = 2.0          # mass of link 1 (kg)
M2 = 1.5          # mass of link 2 (kg)

# Center of mass locations (assuming uniform distribution, from joint)
r1 = L1 / 2.0     # CoM of link 1 from joint 1 (m)
r2 = L2 / 2.0     # CoM of link 2 from joint 2 (m)

# Moments of inertia about CoM
I1_cm = (1.0/12.0) * M1 * L1**2  # kg·m²
I2_cm = (1.0/12.0) * M2 * L2**2  # kg·m²

# Moments of inertia about joints (using parallel axis theorem)
I1 = I1_cm + M1 * r1**2
I2 = I2_cm + M2 * r2**2

G = 9.81          # gravity (m/s²)

# Motor/actuator parameters
TAU_MAX = 30.0    # maximum joint torque (Nm) - REDUCED for stability
DAMPING_1 = 1.5   # joint 1 viscous damping (Nm·s/rad)
DAMPING_2 = 1.0   # joint 2 viscous damping (Nm·s/rad)
DT = 0.01         # simulation time-step (s)

# Joint limits (radians)
Q1_MIN, Q1_MAX = -2.5, 2.5
Q2_MIN, Q2_MAX = -2.0, 2.0
DQ_MAX = 3.0     # maximum joint velocity (rad/s)
DDQ_MAX = 15.0   # maximum joint acceleration (rad/s²)

INPUT_NAMES  = ["tau1", "tau2", "q1", "q2", "dq1", "dq2"]
OUTPUT_NAMES = ["tau1_nn", "tau2_nn", "ddq1", "ddq2"]
N_IN, N_OUT  = len(INPUT_NAMES), len(OUTPUT_NAMES)


# ═══════════════════════════════════════════════════════════════════════════════
# 1.  ROBOT SIMULATOR (with corrected dynamics)
# ═══════════════════════════════════════════════════════════════════════════════

class TwoLinkRobotSimulator:
    """
    Corrected dynamics for a 2-link planar robot with stability measures.
    """
    
    def __init__(self, dt: float = DT):
        self.dt = dt
        self.reset()
        
    def reset(self):
        self.q1 = 0.0
        self.q2 = 0.0
        self.dq1 = 0.0
        self.dq2 = 0.0
        
    def get_end_effector_position(self):
        """Calculate end-effector position in Cartesian coordinates"""
        x = L1 * np.cos(self.q1) + L2 * np.cos(self.q1 + self.q2)
        y = L1 * np.sin(self.q1) + L2 * np.sin(self.q1 + self.q2)
        return x, y
    
    def compute_inertia_matrix(self, q2):
        """Compute corrected mass matrix M(q)"""
        # Using standard manipulator inertia matrix formulation
        m11 = I1 + I2 + M2 * L1**2 + 2 * M2 * L1 * r2 * np.cos(q2)
        m12 = I2 + M2 * L1 * r2 * np.cos(q2)
        m21 = m12
        m22 = I2
        return np.array([[m11, m12], [m21, m22]])
    
    def compute_coriolis_matrix(self, q2, dq1, dq2):
        """Compute corrected Coriolis and centrifugal matrix C(q,dq)"""
        h = -M2 * L1 * r2 * np.sin(q2)
        c11 = h * dq2
        c12 = h * (dq1 + dq2)
        c21 = -h * dq1
        c22 = 0
        return np.array([[c11, c12], [c21, c22]])
    
    def compute_gravity_vector(self, q1, q2):
        """Compute corrected gravity vector G(q)"""
        g1 = (M1 * r1 + M2 * L1) * G * np.cos(q1) + M2 * r2 * G * np.cos(q1 + q2)
        g2 = M2 * r2 * G * np.cos(q1 + q2)
        return np.array([g1, g2])
    
    def compute_dynamics(self, tau1, tau2):
        """Compute joint accelerations using corrected manipulator equations"""
        tau = np.array([tau1, tau2])
        
        # Mass matrix
        M = self.compute_inertia_matrix(self.q2)
        
        # Coriolis matrix
        C = self.compute_coriolis_matrix(self.q2, self.dq1, self.dq2)
        
        # Gravity vector
        G_vec = self.compute_gravity_vector(self.q1, self.q2)
        
        # Damping forces
        damping = np.array([DAMPING_1 * self.dq1, DAMPING_2 * self.dq2])
        
        # Solve for accelerations: M·ddq = τ - C·dq - G - damping
        try:
            ddq = np.linalg.solve(M, tau - C @ np.array([self.dq1, self.dq2]) - G_vec - damping)
            # Clip accelerations for stability
            ddq = np.clip(ddq, -DDQ_MAX, DDQ_MAX)
        except np.linalg.LinAlgError:
            # Singular matrix fallback
            ddq = np.array([0.0, 0.0])
        
        return ddq[0], ddq[1]
    
    def step(self, tau: np.ndarray):
        """
        Advance one timestep with stability measures.
        
        Returns
        -------
        obs     : np.ndarray (6,)  [q1, q2, dq1, dq2, tau1, tau2]
        dyn     : tuple  (tau1_act, tau2_act, ddq1, ddq2)
        """
        tau = np.clip(tau, -TAU_MAX, TAU_MAX)
        tau1, tau2 = tau[0], tau[1]
        dt = self.dt
        
        # Use smaller timestep for integration if needed (simple Euler)
        # For better stability, use semi-implicit Euler
        ddq1, ddq2 = self.compute_dynamics(tau1, tau2)
        
        # Semi-implicit Euler (update velocities first)
        self.dq1 = self.dq1 + ddq1 * dt
        self.dq2 = self.dq2 + ddq2 * dt
        
        # Clip velocities
        self.dq1 = np.clip(self.dq1, -DQ_MAX, DQ_MAX)
        self.dq2 = np.clip(self.dq2, -DQ_MAX, DQ_MAX)
        
        # Update positions
        self.q1 += self.dq1 * dt
        self.q2 += self.dq2 * dt
        
        # Apply joint limits with velocity reflection
        if self.q1 < Q1_MIN:
            self.q1 = Q1_MIN
            self.dq1 = -self.dq1 * 0.5  # Damp reflection
        if self.q1 > Q1_MAX:
            self.q1 = Q1_MAX
            self.dq1 = -self.dq1 * 0.5
            
        if self.q2 < Q2_MIN:
            self.q2 = Q2_MIN
            self.dq2 = -self.dq2 * 0.5
        if self.q2 > Q2_MAX:
            self.q2 = Q2_MAX
            self.dq2 = -self.dq2 * 0.5
        
        obs = np.array([self.q1, self.q2, self.dq1, self.dq2, tau1, tau2], dtype=np.float32)
        return obs, (tau1, tau2, ddq1, ddq2)


